{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".temp/**": "allow"
    },
    "edit": {
      "*": "ask",
      ".temp/**": "allow"
    },
    "task": {
      "*": "ask"
    },
    "skill": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff -- input/requests.md": "allow",
      "node --check app/app.js": "allow",
      "rm *": "deny"
    }
  }
}

